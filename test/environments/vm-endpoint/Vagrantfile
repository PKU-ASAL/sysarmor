# SysArmor endpoint-only VM.
#
# This environment is intentionally single-node. It exists for endpoint agent
# behavior, resource usage, profiling, and long-running soak tests where a
# manager/attacker topology would add noise and startup cost.
#
# Node:
#   node-a 10.66.0.11  monitored endpoint host
ENV['VAGRANT_DEFAULT_PROVIDER'] ||= 'libvirt'
require_relative "../../shared/harness/vagrant-libvirt-compat"

PRIV_NET = <<-SHELL
  set -e
  IP="$1"
  cat >/etc/netplan/60-sysarmor-priv.yaml <<EOF
network:
  version: 2
  renderer: networkd
  ethernets:
    eth1:
      dhcp4: false
      addresses: [$IP/24]
EOF
  chmod 600 /etc/netplan/60-sysarmor-priv.yaml
  netplan apply
  ip -br addr show eth1
SHELL

Vagrant.configure("2") do |c|
  c.vm.synced_folder "../..", "/vagrant/test", type: "rsync",
    rsync__exclude: [".vagrant/", "**/__pycache__/", ".results/", "environments/*/deploy/"]

  c.vm.define "node-a" do |m|
    m.vm.box = "generic/ubuntu2204"
    m.vm.hostname = "node-a"
    m.vm.network "private_network", ip: "10.66.0.11"
    m.vm.provider "libvirt" do |v|
      v.driver = "kvm"
      v.memory = 2048
      v.cpus = 2
    end
    m.vm.provision "priv-net", type: "shell", inline: PRIV_NET, args: ["10.66.0.11"]
    m.vm.provision "shell", path: "../vm-topology/provision/setup-apt.sh"
    m.vm.provision "shell", path: "../vm-topology/provision/setup-credentials.sh"
  end
end
