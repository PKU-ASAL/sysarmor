SYSARMOR_POSTGRES_DRIVER=postgres
SYSARMOR_POSTGRES_DSN=postgres://sysarmor:sysarmor@postgres:5432/sysarmor?sslmode=disable
SYSARMOR_KAFKA_BROKERS=kafka:9092
SYSARMOR_REDIS_ADDR=redis:6379
SYSARMOR_GRPC_TLS_CERT=/etc/sysarmor/pki/gateway.pem
SYSARMOR_GRPC_TLS_KEY=/etc/sysarmor/pki/gateway-key.pem
SYSARMOR_GRPC_CLIENT_CA=/etc/sysarmor/pki/ca.pem
